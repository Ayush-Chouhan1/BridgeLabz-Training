package com.geomeasure;

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        LineManager manager = new LineManager();

        System.out.print("Enter number of lines: ");
        int n = sc.nextInt();

        for (int i = 1; i <= n; i++) {
            System.out.println("Enter coordinates for Line " + i + " (x1 y1 x2 y2):");
            manager.addLine(
                new Line(
                    sc.nextDouble(),
                    sc.nextDouble(),
                    sc.nextDouble(),
                    sc.nextDouble()
                )
            );
        }

        manager.compareAllLines();
    }
}
